# YouTube Buddy Backend - Environment Configuration Example
ENVIRONMENT=development
DEBUG=True

DATABASE_URL=sqlite+aiosqlite:///./dev.db
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
RENDER_DIR=rendered

# Firebase Project Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Auth
JWT_SECRET=replace_with_a_secure_random_secret_in_production
ENABLE_DEMO_LOGIN=True
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Free-Tier AI Providers (₹0 API Expenditure Priority) ─────────────
# 1. Google Gemini (15 RPM free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# 2. Groq (30 RPM free tier, fast inference & whisper-large-v3-turbo): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. OpenRouter (Free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# 4. Default AI Provider: auto (Gemini -> Groq -> OpenRouter -> Ollama -> Builtin fallback)
AI_PROVIDER_DEFAULT=auto
