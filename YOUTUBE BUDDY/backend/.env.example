# YouTube Buddy Backend - Environment Configuration Example
ENVIRONMENT=development
DEBUG=True

DATABASE_URL=sqlite+aiosqlite:///./dev.db
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
RENDER_DIR=rendered

# Firebase Project Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Auth
JWT_SECRET=replace_with_a_secure_random_secret_in_production
ENABLE_DEMO_LOGIN=False
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local-first model execution. No service is assumed free or configured.
ALLOW_REMOTE_INFERENCE=False
AI_PROVIDER_DEFAULT=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=choose_an_installed_local_model
# Optional absolute directories containing installed licensed weights.
LOCAL_IMAGE_MODEL_PATH=
LOCAL_WHISPER_MODEL_PATH=
# Optional cloud keys remain empty; remote use needs explicit owner permission.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
