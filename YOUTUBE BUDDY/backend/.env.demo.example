# PUBLIC local-only demo credentials. Never use this file for a public backend.
ENVIRONMENT=development
ENABLE_DEMO_LOGIN=True
DEMO_LOGIN_EMAIL=demo@youtubebuddy.com
DEMO_LOGIN_PASSWORD=Demo@12345
DATABASE_URL=sqlite+aiosqlite:///./demo.db
ALLOW_REMOTE_INFERENCE=False
AI_PROVIDER_DEFAULT=auto
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=local_demo_only_replace_before_deploying_publicly
